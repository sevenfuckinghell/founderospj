# ------------------------------------------------------------------
# Founder OS — environment template
# Copy to .env.local for development. Never commit real keys.
# ------------------------------------------------------------------

# Demo mode runs the deterministic engine — no keys required.
VITE_DEMO_MODE=true

# Default model routing (changeable live in Settings → AI Providers & Models)
VITE_DEFAULT_REASONING_MODEL=gpt-5
VITE_DEFAULT_FAST_MODEL=claude-haiku-4-6
VITE_DEFAULT_EMBEDDING_MODEL=text-embed-3-lg

# ------------------------------------------------------------------
# Production (server-side) — NEVER expose these to the browser.
# The client talks to your API; the API talks to providers.
# ------------------------------------------------------------------
AI_PROVIDER=openai
AI_API_KEY=
REASONING_MODEL=gpt-5
FAST_MODEL=claude-haiku-4-6
EMBEDDING_MODEL=text-embed-3-lg

DATABASE_URL=
REDIS_URL=
AUTH_SECRET=

# Integrations
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
